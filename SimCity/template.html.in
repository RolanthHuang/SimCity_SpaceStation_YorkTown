<!doctype html>
<html lang="zh-Hant">
<head>
<meta name="yorktown-version" content="11.3.1"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#08131f"><meta name="description" content="Yorktown：在環形太空站建設與經營城市。住宅、工作、交通、水電與財政相互連動的單人城市模擬。"><title>Yorktown · 晨光立體城</title><style>/*STYLE*/</style></head>
<body>
<main id="game">
 <div id="viewport"></div><div id="portal-flash" aria-hidden="true"></div><div class="vignette"></div>
 <header class="topbar">
  <div class="brand"><span class="brand-icon">Y</span><div><strong>YORKTOWN</strong><small>CLEAR DAWN · 11.3.1</small></div></div>
  <div class="metrics"><div><small>財庫 · 信用點</small><strong id="cash">65,000</strong><span id="net" class="positive">— / 月</span></div><div><small>居民</small><strong id="population">120</strong><span id="jobs">—</span></div><div class="happiness-metric"><small>滿意度</small><strong id="happiness">—</strong><span id="employment">—</span></div></div>
  <nav class="top-actions"><button id="orbital-button">船塢與巨構</button><button id="assistant-button">延續街區</button><button id="showcase-toggle" aria-pressed="false">示範城市</button><button id="budget-button">財政</button><button id="save-button">存檔</button><details class="more-menu"><summary>更多</summary><div><button id="new-architecture">晨光新街區</button><button id="arm-button">街區導航</button><button id="space-button">維生</button><button id="data-button">城市報告</button><button id="plant-button">⚡ 電廠更新</button><button id="evolution-gallery">分支進化圖鑑</button><button id="music-toggle" aria-pressed="true">♪ 配樂開啟</button><button id="help-button">操作指南</button></div></details></nav>
 </header>
 <aside class="toolbox panel">
  <div class="eyebrow">DAWN PROGRAMME</div><h1>軌道晨光 · 城市建造</h1>
  <div id="categories" class="categories"></div><div id="tools" class="tools"></div>
  <div id="tool-description" class="tool-description"></div>
 </aside>
 <aside id="inspector" class="inspector panel"><div class="inspector-header"><span class="eyebrow">STATION INTELLIGENCE</span><button id="close-inspector" aria-label="收合資訊">×</button></div><div id="inspection"></div></aside>
 <div class="district-switch"><button id="district-a">曙光花園</button><button id="district-b">星港折臂</button><button id="isolate">專注本臂</button></div><div class="orbit-status"><button id="orbital-badge">船塢計畫</button></div><div class="map-tools"><button id="home" title="回到起始聚落">⌂<span>聚落</span></button><button id="overview" title="全站地圖">◎<span>全站</span></button><button id="rotate" title="旋轉視角">↻</button><button id="zoom-in" title="放大">＋</button><button id="zoom-out" title="縮小">−</button><button id="undo" title="撤銷本月最後一次建造">↶</button></div>
 <div class="overlay-controls"><label for="overlay">資訊圖層</label><select id="overlay"><option value="normal">城市外觀</option><option value="power">電力網路</option><option value="water">供水網路</option><option value="oxygen">氧氣管網</option><option value="cooling">散熱能力</option><option value="traffic">交通壅塞</option><option value="pollution">污染</option><option value="value">地價</option><option value="fire">消防覆蓋</option><option value="police">治安覆蓋</option><option value="school">教育覆蓋</option><option value="hospital">醫療覆蓋</option></select><span id="legend">拖曳平移 · 滾輪縮放</span></div>
 <button id="resume-game" class="resume-game" hidden>已暫停 · 繼續經營 ▶</button>
 <nav class="view-switch" aria-label="視角切換"><button id="rotate-left" title="向左旋轉；方向鍵左" aria-label="向左旋轉">↶</button><button data-view-mode="build" class="active" aria-pressed="true">建造</button><button data-view-mode="walk" aria-pressed="false">步行</button><button data-view-mode="fly" aria-pressed="false">飛行</button><button data-view-mode="overview" aria-pressed="false">全站</button><button id="rotate-right" title="向右旋轉；方向鍵右" aria-label="向右旋轉">↷</button><small id="camera-heading" aria-label="鏡頭方向">0°</small></nav>
 <div class="interior-actions"><button id="interior-exit" hidden>返回街道</button><button id="interior-manage" hidden>營運管理</button></div><div class="habitat-caption"><span id="view-hint">方向鍵轉向 · 左拖平移 · 右拖旋轉 · F 步行 / G 飛行</span><small id="street-count"></small><small id="location-status"></small></div>
 <nav id="surrogate-bar" class="surrogate-bar" aria-label="步行角色與人稱" hidden><button id="perspective-toggle" title="切換人稱 · V" aria-pressed="true">第三人稱</button><button id="surrogate-character" title="選擇角色 · T">澄 · 城市建築師</button><span id="surrogate-status" role="status">步行</span></nav>
 <button id="interaction-button" class="interaction-button" hidden>互動 · E</button>
 <div class="walk-controls" aria-label="觸控步行"><button data-walk-key="KeyW" aria-label="向前走">↑</button><button data-walk-key="Space" aria-label="跳躍或上升">＋</button><button data-walk-key="KeyC" aria-label="下降">−</button><div><button data-walk-key="KeyA" aria-label="向左走">←</button><button data-walk-key="KeyS" aria-label="向後走">↓</button><button data-walk-key="KeyD" aria-label="向右走">→</button></div></div>
 <div id="build-preview" class="build-preview" hidden></div><div id="toast" role="status" aria-live="polite"></div>
 <footer class="bottom-bar">
  <div class="time"><small>殖民曆</small><strong id="date">2263 / 01</strong><div id="speeds"><button data-speed="0" aria-label="暫停">Ⅱ</button><button data-speed="1">1×</button><button data-speed="2">2×</button><button data-speed="4">4×</button></div></div>
  <div id="demand" class="demand"></div><div class="resource-strip"><span id="power-status">電力 —</span><span id="water-status">供水 —</span></div>
  <button id="mission-button" class="mission"><span class="eyebrow">YOUR NEXT CHAPTER</span><strong id="mission-text">讓 300 位居民在此安家 →</strong></button>
 </footer>
 <nav class="living-actions"><button id="sample-ui">建造工具</button><button id="sample-photo">淨空畫面 · H</button><button id="explore-tower">星帆塔 · 六層秘庫</button></nav><div id="showcase-banner" class="demo-banner" hidden>遠航示範城 · 已支付 515,000 · 返回後保留你的城市</div><div class="living-caption"><strong>YORKTOWN / 晨光立體城</strong><small id="sample-live"></small></div>
 <button class="photo-exit" onclick="document.body.classList.remove('sample-photo')">返回介面 · H</button>
 <aside id="structure-hud" class="structure-hud" hidden><strong id="structure-floor"></strong><p id="structure-objective"></p><small id="structure-progress"></small><div class="room-actions"><button id="room-guide">跟隨導覽</button><button id="room-jump">跳躍</button><button id="room-recover">安全點</button><button id="room-exit">返回街道</button></div><button id="room-interact" class="primary" hidden></button></aside><aside id="structure-puzzle" class="structure-puzzle" hidden><div class="room-puzzle-heading"><strong id="structure-puzzle-title"></strong><button id="room-close-puzzle" aria-label="關閉關卡資訊">×</button></div><div id="structure-puzzle-body"></div></aside><div id="loading">正在準備 Yorktown 城市系統…</div>
</main>
<dialog id="modal"><div class="modal-header"><div><span class="eyebrow" id="modal-eyebrow">YORKTOWN</span><h2 id="modal-title"></h2></div><button id="modal-close" aria-label="關閉">×</button></div><div id="modal-body"></div></dialog>
<input type="file" id="import-file" accept=".json,application/json" hidden>
<audio id="city-music" preload="none" loop src="__YORKTOWN_APPROVED_MUSIC__" hidden></audio>
<script>/*BUNDLED_GAME*/</script>
</body></html>
